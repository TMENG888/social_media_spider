# Configure the same values on all three PCs before launching the Redis worker.
# Use the LAN IPv4 address of the PC that hosts Redis, not 127.0.0.1.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
REDIS_RUN_ID=20260926-prod-01

# Lease is refreshed every 30 seconds. A task is recoverable by another PC
# after five minutes without a heartbeat.
REDIS_HEARTBEAT_SECONDS=30
# Three consecutive heartbeat failures request a safe stop before the
# five-minute reclaim window, preventing two PCs from collecting one task.
REDIS_HEARTBEAT_FAILURE_LIMIT=3
REDIS_RECLAIM_IDLE_SECONDS=300
